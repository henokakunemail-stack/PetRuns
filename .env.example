# Copy file ini ke .env di root dan backend/.env, sesuaikan nilainya

# Database (Supabase atau Postgres lokal)
DATABASE_URL="postgresql://user:password@host:5432/petwalk?schema=public"

# JWT
JWT_SECRET="ganti-dengan-string-random-yang-panjang"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="ganti-dengan-string-random-yang-panjang"
JWT_REFRESH_EXPIRES_IN="7d"

# Backend
PORT=3000
NODE_ENV=development

# CORS: daftar origin yang diizinkan, pisahkan dengan koma. Kosongkan untuk permisif (development).
# Contoh production: CORS_ORIGINS="https://admin.petwalk.id"
CORS_ORIGINS=""

# Komisi platform per booking (persen)
PLATFORM_COMMISSION_PERCENT=20

# Midtrans Snap (sandbox dulu, ganti ke production key saat go-live)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=false

# Frontend / Mobile
NEXT_PUBLIC_API_URL="http://localhost:3000"
