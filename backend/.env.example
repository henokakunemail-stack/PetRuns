# Backend env
# Copy ke .env dan sesuaikan nilainya

DATABASE_URL="postgresql://user:password@host:5432/petwalk?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/petwalk?schema=public"

# JWT — generate string random panjang untuk production
JWT_SECRET="dev-jwt-secret-change-me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-change-me"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development

# Persentase komisi platform dari tiap booking (mis. 20 = 20%)
PLATFORM_COMMISSION_PERCENT=20

# Midtrans Snap (sandbox dulu, ganti ke production key saat go-live)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=false

# Firebase Cloud Messaging
# Isi salah satu: JSON mentah atau base64 dari service account Firebase.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_SERVICE_ACCOUNT_BASE64=""

# CORS: daftar origin yang diizinkan, pisahkan dengan koma. Kosongkan untuk permisif development.
CORS_ORIGINS=""
